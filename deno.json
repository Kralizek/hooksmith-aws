    "@aws-sdk/client-sqs": "npm:@aws-sdk/client-sqs@^3.0.0",
    "@hooksmith/core": "jsr:@hooksmith/core@^0.7.0",
    "@hooksmith/pipeline": "jsr:@hooksmith/pipeline@^0.7.0",
    "@hooksmith/runtime": "jsr:@hooksmith/runtime@^0.7.0",
    "@std/assert": "jsr:@std/assert@^1"
